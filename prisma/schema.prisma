model blocks_anchor {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  user_id     String
  destination Json
  last_update DateTime
  created_at  DateTime
}

model blocks_playback {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  user_id     String
  destination Json
  last_update DateTime
  created_at  DateTime
  audio       String
}

model blocks_ivr {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  user_id               String
  destination           Json
  last_update           DateTime
  created_at            DateTime
  audio                 String
  timeout_seconds       Int
  digit_timeout_seconds Int
}

model blocks_timecondition {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  user_id     String
  destination Json
  last_update DateTime
  created_at  DateTime
  timezone    String
  hour        Json
  minute      Json
  second      Json
  day         Json
  month       Json
  year        Json
}